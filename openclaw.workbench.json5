{
  gateway: {
    mode: "local",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },
  agents: {
    ownership: "explicit",
    defaults: {
      model: { primary: "deepseek/deepseek-v4-flash" },
      // Every run must see the agent workspace instructions (AGENTS.md),
      // otherwise the orchestrator cannot apply the domain routing rules.
      contextInjection: "always",
      subagents: { runTimeoutSeconds: 120 },
    },
    entries: {
      main: {
        skills: [],
        models: {
          "deepseek/deepseek-v4-flash": { streaming: false },
        },
        tools: { profile: "minimal" },
      },
      "micro-business": {
        name: "小微业务智能体",
        workspace: "${OPENCLAW_WORKBENCH_AGENT_ROOT}/micro-business",
        skills: [],
        tools: {
          profile: "messaging",
          // Domain delegation is server-bound; the model cannot choose an arbitrary child.
          alsoAllow: ["workbench_delegate_menu_search", "workbench_delegate_form_assistance"],
        },
      },
      "menu-search": {
        name: "菜单搜索智能体",
        workspace: "${OPENCLAW_WORKBENCH_AGENT_ROOT}/menu-search",
        skills: ["menu-search"],
        tools: {
          profile: "minimal",
          // Configured MCP tools are exposed as <safe-server>__<tool-name>.
          alsoAllow: ["ai-workbench__workbench_search_menus"],
        },
      },
      "form-assistant": {
        name: "辅助填单智能体",
        workspace: "${OPENCLAW_WORKBENCH_AGENT_ROOT}/form-assistant",
        skills: ["survey-form-assistance", "fill-borrower-basic-info", "fill-operating-analysis", "extract-financial-statement"],
        tools: {
          profile: "minimal",
          alsoAllow: [
            "ai-workbench__workbench_start_assistance",
            "ai-workbench__workbench_search_customers",
            "ai-workbench__workbench_search_survey_reports",
            "ai-workbench__workbench_get_assistance_state",
            "ai-workbench__workbench_execute_assistance_action",
            "ai-workbench__workbench_get_customer_profile",
            "ai-workbench__workbench_get_business_registration",
            "ai-workbench__workbench_get_one_code_authorization_data",
            "ai-workbench__workbench_get_financial_statement_data",
          ],
        },
      },
      workbench: {
        tools: { profile: "coding" },
      },
    },
  },
  tools: {
    codeMode: { enabled: false },
    swarm: { enabled: true },
  },
  // Keep the MCP server in the normal agent runtime configuration as well as
  // the plugin manifest. The plugin resolver supplies the per-user bearer
  // token at request time, so no user token is persisted here.
  mcp: {
    servers: {
      "ai-workbench": {
        transport: "streamable-http",
        url: "${OPENCLAW_WORKBENCH_MCP_URL}",
        connectionTimeoutMs: 15000,
        requestTimeoutMs: 120000,
      },
    },
  },
  plugins: {
    slots: {
      memory: "none",
    },
    entries: {
      deepseek: { enabled: true },
      "workbench-claw-service": {
        enabled: true,
        config: {
          defaultAgentId: "micro-business",
          model: "deepseek/deepseek-v4-flash",
          mcpUrl: "${OPENCLAW_WORKBENCH_MCP_URL}",
          clawTokenTtlSeconds: 3600,
          runRetentionSeconds: 3600,
        },
      },
    },
  },
}
